.7 296.4 L187.8 294.2 L190.8 291.8 L193.7 289.4 L196.6 286.9 L199.4 284.4 L202.1 281.7 L204.8 279.0 L207.4 276.2 L209.9 273.4 L212.4 270.5 L214.7 267.5 L217.0 264.4 L219.2 261.3 L221.3 258.2 L223.4 255.0 L225.3 251.7 L227.2 248.4 L229.0 245.0 L230.6 241.6 L232.2 238.1 L233.7 234.6 L235.1 231.1 L236.4 227.5 L237.6 223.9 L238.7 220.3 L239.8 216.6 L240.7 212.9 L241.1 211.0"/></svg>{%- if section.settings.eyebrow != blank -%}<p class="ahi-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}<h1 class="ahi-h" aria-label="{{ section.settings.heading | escape }}">{%- for word in words -%}{%- unless forloop.first -%}<span class="sp" aria-hidden="true"></span>{%- endunless -%}<span class="w" aria-hidden="true">{%- assign chars = word | split: "" -%}{%- for c in chars -%}<span class="ch" style="--i:{{ i }}">{{ c }}</span>{%- assign i = i | plus: 1 -%}{%- endfor -%}</span>{%- endfor -%}</h1>{%- if section.settings.tagline != blank -%}<div class="ahi-tag">{{ section.settings.tagline }}</div>{%- endif -%}<div class="ahi-cta">{%- if section.settings.btn1_label != blank -%}<a class="ahi-btn" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label | escape }}</a>{%- endif -%}{%- if section.settings.btn2_label != blank -%}<a class="ahi-link" href="{{ section.settings.btn2_link | default: routes.root_url }}">{{ section.settings.btn2_label | escape }}</a>{%- endif -%}</div></div><div class="ahi-meta"><span>{{ section.settings.meta_left | escape }}</span>{%- if section.settings.replay -%}<button type="button" class="ahi-replay">Replay ↺</button>{%- else -%}<span>{{ section.settings.meta_right | escape }}</span>{%- endif -%}</div><span class="ahi-scroll" aria-hidden="true"></span></section><noscript><style>.ahi .ahi-strand{stroke-dashoffset:0}.ahi .ahi-gap,.ahi .ahi-over,.ahi .ahi-eyebrow,.ahi .ahi-meta,.ahi .ahi-tag,.ahi .ahi-cta{opacity:1;transform:none}.ahi .ahi-h .ch{transform:none}</style></noscript>
{%- endif -%}
{% stylesheet %}
.ahi{--ahi-display:"Archivo","Helvetica Neue",Arial,sans-serif;--ahi-serif:"Bodoni Moda","Didot",Georgia,serif;--ahi-sans:"Inter","Helvetica Neue",Arial,sans-serif;--ahi-mono:"IBM Plex Mono","SFMono-Regular",Menlo,monospace;--ahi-ease:cubic-bezier(.2,.7,.2,1);--ahi-muted:color-mix(in srgb,var(--ahi-fg) 62%,var(--ahi-bg));position:relative;overflow:hidden;display:grid;place-items:center;min-height:calc(100svh - var(--ahi-top,0px));padding:clamp(40px,8vh,96px) clamp(20px,5vw,72px);background:var(--ahi-bg);color:var(--ahi-fg);font-family:var(--ahi-sans);text-align:center;-webkit-font-smoothing:antialiased}
.ahi-in{display:flex;flex-direction:column;align-items:center;max-width:1100px}
.ahi-knot{width:clamp(120px,17vw,220px);height:auto;overflow:visible;margin-bottom:clamp(22px,4vh,40px)}
.ahi-knot path{fill:none;stroke-linecap:round;stroke-linejoin:round}
.ahi-strand{stroke:var(--ahi-fg);stroke-width:var(--ahi-w);stroke-dasharray:var(--ahi-len);stroke-dashoffset:var(--ahi-len)}
.ahi-gap{stroke:var(--ahi-bg);stroke-width:calc(var(--ahi-w) + 18px);stroke-linecap:butt!important;opacity:0}
.ahi-over{stroke:var(--ahi-fg);stroke-width:var(--ahi-w);stroke-linecap:butt!important;opacity:0}
.ahi-ring{fill:none;stroke:var(--ahi-accent);stroke-width:2;opacity:0;transform-origin:200px 200px}
.ahi-eyebrow{display:inline-flex;align-items:center;gap:12px;margin:0 0 22px;font-family:var(--ahi-mono);font-size:11.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ahi-muted);opacity:0}
.ahi-eyebrow:before{content:"";width:7px;height:7px;background:var(--ahi-accent);flex:none}
.ahi-h{margin:0;display:flex;justify-content:center;gap:.04em;font-family:var(--ahi-display);font-stretch:125%;font-weight:600;font-size:clamp(56px,11vw,184px);line-height:.9;letter-spacing:-.015em;text-transform:uppercase;color:inherit}
.ahi-h .w{display:inline-flex;overflow:hidden;padding:.02em 0}
.ahi-h .sp{width:.28em}
.ahi-h .ch{display:inline-block;transform:translateY(105%)}
.ahi-tag{margin:clamp(16px,2.6vh,26px) 0 0;font-family:var(--ahi-display);font-stretch:125%;font-weight:600;font-size:clamp(17px,1.9vw,28px);letter-spacing:.04em;text-transform:uppercase;opacity:0;transform:translateY(14px)}
.ahi-tag p{margin:0}.ahi-tag em{font-family:var(--ahi-serif);font-stretch:100%;font-style:italic;font-weight:400;text-transform:none;letter-spacing:0}
.ahi-cta{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 28px;align-items:center;margin-top:clamp(26px,4.5vh,44px);opacity:0;transform:translateY(14px)}
.ahi .ahi-btn{position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:0 34px;border:1.5px solid var(--ahi-fg);border-radius:0;background:var(--ahi-fg);color:var(--ahi-bg);font-family:var(--ahi-mono);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;transition:color .5s var(--ahi-ease),border-color .5s var(--ahi-ease)}
.ahi .ahi-btn:before{content:"";position:absolute;inset:0;z-index:-1;background:var(--ahi-accent);transform:scaleX(0);transform-origin:right;transition:transform .6s var(--ahi-ease)}
.ahi .ahi-btn:hover{color:#111;border-color:var(--ahi-accent)}
.ahi .ahi-btn:hover:before{transform:scaleX(1);transform-origin:left}
.ahi .ahi-link{display:inline-flex;padding-bottom:6px;background:linear-gradient(currentColor,currentColor) left bottom/100% 1px no-repeat;font-family:var(--ahi-mono);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:var(--ahi-fg);transition:background-size .6s var(--ahi-ease)}
.ahi .ahi-link:hover{background-size:0 1px;background-position:right bottom}
.ahi .ahi-btn:focus-visible,.ahi .ahi-link:focus-visible,.ahi-replay:focus-visible{outline:1px solid var(--ahi-accent);outline-offset:4px}
.ahi-meta{position:absolute;left:clamp(20px,5vw,72px);right:clamp(20px,5vw,72px);bottom:22px;display:flex;justify-content:space-between;font-family:var(--ahi-mono);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ahi-muted);opacity:0}
.ahi-replay{background:none;border:0;padding:0;font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;cursor:pointer}
.ahi-replay:hover{color:var(--ahi-fg)}
.ahi-scroll{position:absolute;left:50%;bottom:20px;width:1px;height:48px;overflow:hidden;background:color-mix(in srgb,var(--ahi-fg) 25%,transparent);opacity:0}
.ahi-scroll:after{content:"";position:absolute;inset:0;background:var(--ahi-fg);animation:ahi-scroll 2.4s var(--ahi-ease) infinite}
@keyframes ahi-scroll{0%{transform:translateY(-100%)}60%,100%{transform:translateY(100%)}}

/* the sequence */
.ahi.is-play .ahi-strand{animation:ahi-draw 1.9s cubic-bezier(.65,0,.35,1) .25s forwards}
.ahi.is-play .ahi-gap,.ahi.is-play .ahi-over{animation:ahi-fade .18s linear 2.05s forwards}
.ahi.is-play .ahi-knot{animation:ahi-settle 1.1s var(--ahi-ease) 2.05s both}
.ahi.is-play .ahi-ring{animation:ahi-ring 1.2s var(--ahi-ease) 2.1s forwards}
.ahi.is-play .ahi-eyebrow{animation:ahi-up .8s var(--ahi-ease) 2.2s forwards}
.ahi.is-play .ahi-h .ch{animation:ahi-rise .9s var(--ahi-ease) calc(2.35s + var(--i) * 55ms) forwards}
.ahi.is-play .ahi-tag{animation:ahi-up .9s var(--ahi-ease) 3.05s forwards}
.ahi.is-play .ahi-cta{animation:ahi-up .9s var(--ahi-ease) 3.35s forwards}
.ahi.is-play .ahi-meta,.ahi.is-play .ahi-scroll{animation:ahi-fade .8s linear 3.7s forwards}
@keyframes ahi-draw{to{stroke-dashoffset:0}}
@keyframes ahi-fade{to{opacity:1}}
@keyframes ahi-settle{0%{transform:scale(1)}35%{transform:scale(1.06)}100%{transform:scale(1)}}
@keyframes ahi-ring{0%{opacity:.9;transform:scale(.6)}100%{opacity:0;transform:scale(1.35)}}
@keyframes ahi-up{to{opacity:1;transform:none}}
@keyframes ahi-rise{to{transform:none}}

/* finished state: no motion (repeat visits, reduced motion, no JS) */
.ahi.is-done .ahi-strand{stroke-dashoffset:0}
.ahi.is-done .ahi-gap,.ahi.is-done .ahi-over,.ahi.is-done .ahi-eyebrow,.ahi.is-done .ahi-meta,.ahi.is-done .ahi-scroll{opacity:1}
.ahi.is-done .ahi-h .ch,.ahi.is-done .ahi-tag,.ahi.is-done .ahi-cta{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.ahi:not(.is-force) .ahi-strand{stroke-dashoffset:0!important;animation:none!important}.ahi:not(.is-force) .ahi-gap,.ahi:not(.is-force) .ahi-over,.ahi:not(.is-force) .ahi-eyebrow,.ahi:not(.is-force) .ahi-meta,.ahi:not(.is-force) .ahi-scroll,.ahi:not(.is-force) .ahi-tag,.ahi:not(.is-force) .ahi-cta{opacity:1!important;transform:none!important;animation:none!important}.ahi:not(.is-force) .ahi-h .ch{transform:none!important;animation:none!important}.ahi:not(.is-force) .ahi-ring,.ahi:not(.is-force) .ahi-scroll:after{display:none}}
@media (max-width:600px){.ahi-meta{bottom:16px;font-size:10px}.ahi-meta span:first-child{display:none}.ahi-meta{justify-content:center}.ahi-scroll{display:none}}

{% endstylesheet %}
{% javascript %}
(function(){
  function init(root){
    if(!root||root.dataset.ahiReady)return;root.dataset.ahiReady='1';
    var strand=root.querySelector('.ahi-strand');
    if(strand){var L=Math.ceil(strand.getTotalLength());root.style.setProperty('--ahi-len',L);}
    var once=root.dataset.once==='true',key='ahi-played';
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var seen=false;try{seen=once&&sessionStorage.getItem(key)==='1';}catch(e){}
    function done(){root.classList.remove('is-play');root.classList.add('is-done');}
    function play(force){
      clearTimeout(root._t);
      if(force)root.classList.add('is-force');
      root.classList.remove('is-done','is-play');
      try{(root.getAnimations?root.getAnimations({subtree:true}):[]).forEach(function(a){a.cancel();});}catch(e){}
      void root.offsetWidth;
      requestAnimationFrame(function(){requestAnimationFrame(function(){root.classList.add('is-play');});});
      try{if(once)sessionStorage.setItem(key,'1');}catch(e){}
      root._t=setTimeout(function(){done();root.classList.remove('is-force');},5400);
    }
    if(reduce||seen||root.closest('.shopify-section')&&window.Shopify&&Shopify.designMode&&root.dataset.editor==='still'){done();}
    else{
      if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){play();io.disconnect();}});},{threshold:.35});io.observe(root);}
      else play();
    }
    var r=root.querySelector('.ahi-replay');if(r)r.addEventListener('click',function(){play(true);});
  }
  function all(){document.querySelectorAll('.ahi').forEach(init);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',all);else all();
  document.addEventListener('shopify:section:load',function(e){var el=e.target.querySelector('.ahi');if(el){delete el.dataset.ahiReady;init(el);}});
})();

{% endjavascript %}
