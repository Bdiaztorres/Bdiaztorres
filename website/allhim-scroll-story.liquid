{%- unless has_photos -%}<g class="ss-mark" opacity="0" fill="#F2EFE9" text-anchor="middle"><text x="500" y="492" font-family="Bodoni Moda, Georgia, serif" font-style="italic" font-size="58">{{ section.settings.chest_script | escape }}</text><text x="500" y="530" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="4">{{ section.settings.chest_small | escape }}</text></g>{%- endunless -%}
</svg>
      {%- endunless -%}
      {%- for block in steps -%}
        {%- if block.settings.image -%}
        <div class="ss-frame" data-step="{{ forloop.index0 }}">
          {%- assign alt = block.settings.image.alt | default: block.settings.label -%}
          {{ block.settings.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 900px) 45vw, 90vw', alt: alt, loading: 'eager' }}
        </div>
        {%- endif -%}
      {%- endfor -%}
      {%- for block in chips -%}
      <div class="ss-chip ss-{{ block.settings.spot }}" {{ block.shopify_attributes }}><small>{{ block.settings.label | escape }}</small><strong>{{ block.settings.value | escape }}</strong></div>
      {%- endfor -%}
      {%- if steps.size > 1 -%}<p class="ss-count" aria-hidden="true"><b>01</b> / 0{{ steps.size }}</p>{%- endif -%}
    </div>
    {%- if section.settings.show_dots and steps.size > 1 -%}
    <div class="ss-rail" role="group" aria-label="Story steps">
      {%- for block in steps -%}<button type="button" aria-label="Step {{ forloop.index }}: {{ block.settings.line1 | escape }} {{ block.settings.line2 | escape }}"></button>{%- endfor -%}
    </div>
    {%- endif -%}
    {%- if section.settings.show_hint -%}<div class="ss-scroll" aria-hidden="true"></div>{%- endif -%}
  </div>
</div>
<script>
(()=>{
  const root=document.getElementById('ss-{{ section.id }}'); if(!root||root.dataset.ready)return; root.dataset.ready='1';
  const q=s=>root.querySelector(s), qa=s=>[...root.querySelectorAll(s)];
  const panels=qa('.ss-panel'), chips=qa('.ss-chip'), dots=qa('.ss-rail button'), hint=q('.ss-scroll'), count=q('.ss-count b');
  const frames=qa('.ss-frame'), photoMode=frames.length>0;
  const strand=q('.ss-strand'), patches=qa('.patch'), knot=q('.ss-knot'), fibers=qa('.ss-fiber');
  const hoodie=q('.ss-hoodie'), hfill=q('.ss-hfill'), hline=q('.ss-hline'), hlines=qa('.ss-hline path'), mark=q('.ss-mark'), shadow=q('.ss-shadow');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v)), seg=(p,a,b)=>clamp((p-a)/(b-a));
  const ease=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2, lerp=(a,b,t)=>a+(b-a)*t;
  const rgb=v=>{const c=document.createElement('canvas').getContext('2d');c.fillStyle=getComputedStyle(root).getPropertyValue(v).trim()||'#111';const h=c.fillStyle.replace('#','');return [0,2,4].map(i=>parseInt(h.substr(i,2),16))};
  const fg=rgb('--ss-fg'), cream=[242,239,233];
  const tint=t=>`rgb(${fg.map((v,i)=>Math.round(lerp(v,cream[i],t))).join(',')})`;
  const n=Math.max(panels.length,1);
  // each step owns an even share of the scroll; a step's copy fades in and out at the edges of its share
  const WIN=panels.map((_,i)=>{const a=i/n,b=(i+1)/n;return [i?a-.03:-.2,i?a+.05:0,i<n-1?b-.06:1,i<n-1?b+.01:1.2]});
  let intro=reduce?1:0,t0=null,cur=0,target=0,visible=true;
  new IntersectionObserver(e=>{visible=e[0].isIntersecting}).observe(root);
  const progress=()=>{const r=root.getBoundingClientRect(),t=root.offsetHeight-innerHeight;return t>0?clamp(-r.top/t):0};
  const step1=1/n;
  function render(p){
    // the knot draws itself when the page opens; loose threads drift off as you scroll
    if(strand){
      const d=ease(clamp(intro)), drift=seg(p,0,step1*.9);
      strand.style.strokeDasharray='1 1'; strand.style.strokeDashoffset=String(1-d);
      patches.forEach(g=>g.style.opacity=seg(intro,.86,1));
      fibers.forEach(f=>{f.style.opacity=String((1-drift)*seg(intro,.4,1)*.8);f.style.translate=`${f.dataset.dx*drift*160}px ${f.dataset.dy*drift*160}px`});
      if(photoMode){
        // the knot tightens and fades as the first photo wipes up over it
        const m=ease(seg(p,step1-.1,step1+.03));
        knot.setAttribute('transform',`translate(500 500) rotate(${lerp(-8+drift*8,0,m)}) scale(${lerp(1,.35,m)}) translate(-500 -500)`);
        knot.style.opacity=String(1-m);
      }else{
        // no photos yet: the knot lands on the chest of the drawn hoodie
        const m=ease(seg(p,.30,.54)), f=ease(seg(p,.50,.60)), ld=ease(seg(p,.33,.53));
        knot.setAttribute('transform',`translate(500 ${lerp(500,372,m)}) rotate(${lerp(-8+drift*8,0,m)}) scale(${lerp(1,.15,m)}) translate(-500 -500)`);
        hlines.forEach((l,i)=>{l.style.strokeDasharray='1 1';l.style.strokeDashoffset=String(1-clamp(ld*1.15-i*.02))});
        hfill.setAttribute('opacity',f.toFixed(3)); hline.setAttribute('opacity',(1-f*.85).toFixed(3));
        knot.style.color=tint(f);
        mark.setAttribute('opacity',ease(seg(p,.56,.64)).toFixed(3));
        shadow.setAttribute('opacity',(f*.12).toFixed(3));
        hoodie.setAttribute('transform',`translate(0 ${reduce?0:Math.sin(performance.now()/900)*seg(p,.6,.7)*4})`);
      }
    }
    // photos: each wipes up from the bottom at the start of its step, then settles from a slow zoom
    frames.forEach(fr=>{
      const i=+fr.dataset.step, a=i/n, w=i===0?1:ease(seg(p,a-.09,a+.03));
      const z=lerp(1.12,1,ease(seg(p,a-.09,Math.min(a+1/n,1))));
      fr.style.clipPath=`inset(${((1-w)*100).toFixed(2)}% 0 0 0)`;
      fr.style.setProperty('--zoom',z.toFixed(4));
    });
    const last=(n-1)/n;
    chips.forEach((c,i)=>{const k=ease(seg(p,last+.04+i*.035,last+.12+i*.035));c.style.opacity=k;c.style.transform=`translateY(${(1-k)*14}px)`});
    let active=0;
    panels.forEach((el,i)=>{
      const [a,b,c,d]=WIN[i], o=p<b?seg(p,a,b):1-seg(p,c,d);
      el.style.opacity=o.toFixed(3); el.style.transform=`translateY(${(p<b?1-o:-(1-o))*22}px)`;
      el.style.setProperty('--rise',`${((1-ease(o))*105).toFixed(1)}%`); el.classList.toggle('is-on',o>.5); if(o>.5)active=i;
    });
    dots.forEach((b,i)=>b.setAttribute('aria-current',String(i===active)));
    if(count)count.textContent=String(active+1).padStart(2,'0');
    if(hint)hint.style.opacity=String(1-seg(p,0,.05));
  }
  function frame(ts){
    if(t0===null)t0=ts;
    if(!reduce)intro=clamp((ts-t0-250)/1900);
    if(visible||intro<1){target=progress();cur=reduce?target:lerp(cur,target,.12);if(Math.abs(cur-target)<.0005)cur=target;render(cur);}
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  const goTo=i=>{const t=root.offsetHeight-innerHeight;scrollTo({top:root.getBoundingClientRect().top+scrollY+t*(i===0?0:Math.min((i+.45)/n,1)),behavior:reduce?'auto':'smooth'})};
  dots.forEach((b,i)=>b.addEventListener('click',()=>goTo(i)));
  if(window.Shopify&&Shopify.designMode)document.addEventListener('shopify:block:select',e=>{const i=panels.indexOf(e.target);if(i>-1)goTo(i)});
})();

</script>
