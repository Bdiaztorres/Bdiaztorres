<script>
(()=>{
  const root=document.getElementById('ss-{{ section.id }}'); if(!root||root.dataset.ready)return; root.dataset.ready='1';
  const q=s=>root.querySelector(s), qa=s=>[...root.querySelectorAll(s)];
  const panels=qa('.ss-panel'), chips=qa('.ss-chip'), dots=qa('.ss-rail button'), hint=q('.ss-hint');
  const strand=q('.ss-strand'), patches=qa('.patch'), knot=q('.ss-knot'), fibers=qa('.ss-fiber');
  const hfill=q('.ss-hfill'), hlines=qa('.ss-hline path'), hline=q('.ss-hline'), mark=q('.ss-mark'), shadow=q('.ss-shadow');
  const hoodie=q('.ss-hoodie'), photo=q('.ss-photo'), video=q('.ss-video');
  const hasImage=root.dataset.hasImage==='true';
  const knotY=(+root.dataset.knotY||37)*10, knotS=(+root.dataset.knotSize||15)/100;
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v)), seg=(p,a,b)=>clamp((p-a)/(b-a));
  const ease=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2, lerp=(a,b,t)=>a+(b-a)*t;
  const hex=h=>{h=getComputedStyle(root).getPropertyValue(h).trim().replace('#','');if(h.length===3)h=[...h].map(c=>c+c).join('');return [0,2,4].map(i=>parseInt(h.substr(i,2),16)||0)};
  const ink=hex('--ss-text'), light=[242,239,233];
  const mixc=t=>`rgb(${ink.map((v,i)=>Math.round(lerp(v,light[i],t))).join(',')})`;
  // each step's copy is on screen for an even share of the scroll
  const n=Math.max(panels.length,1);
  const WIN=panels.map((_,i)=>{const a=i/n,b=(i+1)/n;return [i?a-.02:-.2,i?a+.06:0,i<n-1?b-.06:1,i<n-1?b+.02:1.2]});
  if(video){video.pause();video.removeAttribute('autoplay');}
  let intro=reduce?1:0,t0=null,cur=0,target=0,visible=true;
  new IntersectionObserver(e=>{visible=e[0].isIntersecting}).observe(root);
  const progress=()=>{const r=root.getBoundingClientRect(),t=root.offsetHeight-innerHeight;return t>0?clamp(-r.top/t):0};
  function render(p){
    if(video&&video.duration){video.currentTime=p*(video.duration-.05);}
    if(strand){
      const d=ease(clamp(intro));
      strand.style.strokeDasharray='1 1';strand.style.strokeDashoffset=String(1-d);
      patches.forEach(g=>g.style.opacity=seg(intro,.86,1));
      const drift=seg(p,0,.3);
      fibers.forEach(f=>{f.style.opacity=String((1-drift)*seg(intro,.4,1)*.8);f.style.translate=`${f.dataset.dx*drift*160}px ${f.dataset.dy*drift*160}px`;f.style.color='inherit'});
      const m=ease(seg(p,.30,.54));
      knot.setAttribute('transform',`translate(500 ${lerp(500,knotY,m)}) rotate(${lerp(-8+drift*8,0,m)}) scale(${lerp(1,knotS,m)}) translate(-500 -500)`);
      const f=ease(seg(p,.50,.60));
      if(hasImage){
        photo.style.opacity=f;photo.style.transform=`scale(${lerp(.94,1,f)})`;
        knot.style.opacity=String(1-f);
      }else if(hoodie){
        const ld=ease(seg(p,.33,.53));
        hlines.forEach((l,i)=>{l.style.strokeDasharray='1 1';l.style.strokeDashoffset=String(1-clamp(ld*1.15-i*.02))});
        hfill.setAttribute('opacity',f.toFixed(3));hline.setAttribute('opacity',(1-f*.85).toFixed(3));
        knot.style.color=mixc(f);
        if(mark)mark.setAttribute('opacity',ease(seg(p,.56,.64)).toFixed(3));
        const bob=reduce?0:Math.sin(performance.now()/900)*seg(p,.6,.7);
        hoodie.setAttribute('transform',`translate(0 ${bob*4})`);
      }
      shadow.setAttribute('opacity',(f*.12).toFixed(3));
    }
    chips.forEach((c,i)=>{const k=ease(seg(p,.70+i*.04,.80+i*.04));c.style.opacity=k;c.style.transform=`translateY(${(1-k)*14}px)`});
    let active=0;
    panels.forEach((el,i)=>{
      const [a,b,c,d]=WIN[i], o=p<b?seg(p,a,b):1-seg(p,c,d);
      el.style.opacity=o.toFixed(3);el.style.transform=`translateY(${(p<b?1-o:-(1-o))*24}px)`;
      el.style.setProperty('--rise',`${(1-ease(o))*100}%`);el.classList.toggle('is-on',o>.5);if(o>.5)active=i;
    });
    dots.forEach((b,i)=>b.setAttribute('aria-current',String(i===active)));
    if(hint)hint.style.opacity=String(1-seg(p,0,.06));
  }
  function frame(ts){
    if(t0===null)t0=ts;
    if(!reduce)intro=clamp((ts-t0-250)/1900);
    if(visible||intro<1){target=progress();cur=reduce?target:lerp(cur,target,.12);if(Math.abs(cur-target)<.0005)cur=target;render(cur);}
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  dots.forEach((b,i)=>b.addEventListener('click',()=>{
    const t=root.offsetHeight-innerHeight, stop=n>1?(i+.5)/n:0;
    scrollTo({top:root.getBoundingClientRect().top+scrollY+t*(i===0?0:Math.min(stop+.1,1)),behavior:reduce?'auto':'smooth'});
  }));
  if(window.Shopify&&Shopify.designMode){document.addEventListener('shopify:block:select',e=>{const i=panels.indexOf(e.target);if(i>-1)dots[i]&&dots[i].click()})}
})();

</script>
