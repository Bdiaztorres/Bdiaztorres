{%- comment -%}
  All Him scroll story: the knot weaves itself, lands on the hoodie, then label chips float in.
  Add it in Online Store > Themes > Customize > Add section > "All Him scroll story".
{%- endcomment -%}
{%- if section.settings.editorial_font -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Mrs+Saint+Delafield&display=swap" rel="stylesheet">
{%- endif -%}
{%- assign steps = section.blocks | where: "type", "step" -%}
{%- assign chips = section.blocks | where: "type", "chip" -%}
<style>
#ss-{{ section.id }}{--ss-bg:{{ section.settings.bg }};--ss-text:{{ section.settings.text }};--ss-top:{{ section.settings.top_offset }}px;--ss-len:{{ section.settings.length }}00vh;
{%- if section.settings.editorial_font -%}--ss-serif:"Instrument Serif",Georgia,serif;{%- else -%}--ss-serif:var(--font-heading--family,Georgia),serif;{%- endif -%}}
.ss{position:relative;height:var(--ss-len);background:var(--ss-bg);color:var(--ss-text)}
.ss *{box-sizing:border-box}
.ss-stage{position:sticky;top:var(--ss-top);height:calc(100vh - var(--ss-top));height:calc(100svh - var(--ss-top));overflow:hidden;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:center;padding:24px clamp(18px,4vw,56px)}
.ss-copy{position:relative;height:min(560px,70vh)}
.ss-panel{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;opacity:0;pointer-events:none}
.ss-panel.is-on{pointer-events:auto}
.ss-num{display:flex;align-items:baseline;gap:14px;margin-bottom:10px}
.ss-num b{font-family:var(--ss-serif);font-weight:400;font-size:44px;line-height:1}
.ss-num span{font-size:11px;letter-spacing:.22em;text-transform:uppercase;opacity:.65}
.ss-h{font-family:var(--ss-serif);font-weight:400;text-transform:uppercase;font-size:clamp(64px,8.6vw,148px);line-height:.86;letter-spacing:-.01em;margin:0 0 22px;color:inherit}
.ss-h span{display:block;overflow:hidden}
.ss-h em{display:block;font-style:normal;transform:translateY(var(--rise,0%))}
.ss-panel p{max-width:34ch;margin:0 0 26px;font-size:15px;line-height:1.55;opacity:.85}
.ss-ctas{display:flex;gap:12px;flex-wrap:wrap}
.ss-pill{display:inline-flex;align-items:center;min-height:44px;padding:0 22px;border-radius:999px;background:var(--ss-text);color:var(--ss-bg);border:1px solid var(--ss-text);text-decoration:none;font-size:13px;font-weight:500;letter-spacing:.02em}
.ss-pill.ss-ghost{background:transparent;color:var(--ss-text)}
.ss-visual{position:relative;justify-self:center;width:min(78vh,52vw);aspect-ratio:1}
.ss-art,.ss-photo,.ss-video{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ss-photo,.ss-video{object-fit:contain;opacity:0}
.ss-video{opacity:1}
.ss .patch{opacity:0}
.ss-chip{position:absolute;display:flex;flex-direction:column;gap:2px;padding:10px 14px 11px;background:rgba(250,248,244,.92);color:#111;border:1px solid #d6d1c7;border-radius:12px;box-shadow:0 10px 30px -12px rgba(0,0,0,.25);opacity:0;white-space:nowrap}
.ss-chip small{font-size:10px;letter-spacing:.2em;text-transform:uppercase;opacity:.65}
.ss-chip strong{font-weight:500;font-size:13px}
.ss-top-left{left:-4%;top:22%}.ss-top-right{right:-6%;top:30%}.ss-bottom-left{left:0;top:66%}.ss-bottom-right{right:-2%;top:74%}
.ss-rail{position:absolute;right:clamp(10px,1.6vw,24px);top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:6px}
.ss-rail button{width:44px;height:44px;border:0;background:none;cursor:pointer;display:grid;place-items:center;padding:0;color:inherit}
.ss-rail button::after{content:"";width:7px;height:7px;border-radius:50%;border:1px solid currentColor;transition:background .3s,transform .3s}
.ss-rail button[aria-current="true"]::after{background:currentColor;transform:scale(1.25)}
.ss-hint{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);font-size:11px;letter-spacing:.24em;text-transform:uppercase;opacity:.6;display:flex;flex-direction:column;align-items:center;gap:8px}
.ss-hint::after{content:"";width:1px;height:34px;background:currentColor;animation:ss-drip 1.8s ease-in-out infinite;transform-origin:top}
@keyframes ss-drip{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(1);opacity:0}}
@media (max-width:860px){
  .ss-stage{grid-template-columns:1fr;grid-template-rows:auto 1fr;align-items:start;padding-top:20px}
  .ss-copy{height:275px}
  .ss-panel{justify-content:flex-start}
  .ss-h{font-size:clamp(50px,15vw,84px);margin-bottom:12px}
  .ss-num b{font-size:30px}
  .ss-panel p{font-size:14px;margin-bottom:14px;max-width:40ch}
  .ss-visual{width:min(92vw,52vh);align-self:center}
  .ss-chip{padding:7px 10px 8px}.ss-chip strong{font-size:12px}
  .ss-top-left,.ss-bottom-left{left:0}.ss-top-right,.ss-bottom-right{right:0}
  .ss-rail,.ss-hint{display:none}
}
@media (prefers-reduced-motion:reduce){.ss-hint::after{animation:none}}

</style>
<div id="ss-{{ section.id }}" class="ss" data-knot-y="{{ section.settings.knot_y }}" data-knot-size="{{ section.settings.knot_size }}" data-has-image="{%- if section.settings.product_image -%}true{%- else -%}false{%- endif -%}">
  <div class="ss-stage">
    <div class="ss-copy">
      {%- for block in steps -%}
      <div class="ss-panel" {{ block.shopify_attributes }}>
        <div class="ss-num"><b>{{ block.settings.number | escape }}</b><span>{{ block.settings.label | escape }}</span></div>
        {%- if forloop.first -%}<h1 class="ss-h">{%- else -%}<h2 class="ss-h">{%- endif -%}
          <span><em>{{ block.settings.line1 | escape }}</em></span><span><em>{{ block.settings.line2 | escape }}</em></span>
        {%- if forloop.first -%}</h1>{%- else -%}</h2>{%- endif -%}
        {%- if block.settings.text and block.settings.text != blank -%}<p>{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
        <div class="ss-ctas">
          {%- if block.settings.button_label and block.settings.button_label != blank -%}<a class="ss-pill" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
          {%- if block.settings.button2_label and block.settings.button2_label != blank -%}<a class="ss-pill ss-ghost" href="{{ block.settings.button2_link | default: routes.all_products_collection_url }}">{{ block.settings.button2_label | escape }}</a>{%- endif -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
    <div class="ss-visual">
      {%- if section.settings.video -%}
        {{ section.settings.video | video_tag: class: 'ss-video', muted: true, playsinline: true, preload: 'auto', image_size: '1600x' }}
      {%- else -%}
        {%- if section.settings.product_image -%}
          {{ section.settings.product_image | image_url: width: 1600 | image_tag: class: 'ss-photo', alt: section.settings.product_image.alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 860px) 52vw, 92vw' }}
        {%- endif -%}
        <svg class="ss-art" viewBox="0 0 1000 1000" role="img" aria-label="{{ section.settings.art_label | escape }}">
