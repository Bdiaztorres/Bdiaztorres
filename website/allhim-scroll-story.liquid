{%- comment -%} All Him scroll story. Add it in Customize > Add section > "All Him scroll story". {%- endcomment -%}
{%- if section.settings.load_fonts -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=Bodoni+Moda:ital,wght@1,400&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}
{%- assign steps = section.blocks | where: "type", "step" -%}
{%- assign chips = section.blocks | where: "type", "chip" -%}
{%- assign has_photos = false -%}
{%- for block in steps -%}{%- if block.settings.image -%}{%- assign has_photos = true -%}{%- endif -%}{%- endfor -%}
{%- assign first_has_photo = false -%}
{%- if steps.first.settings.image -%}{%- assign first_has_photo = true -%}{%- endif -%}
<style>
#ss-{{ section.id }}{--ss-bg:{{ section.settings.bg }};--ss-fg:{{ section.settings.fg }};--ss-accent:{{ section.settings.accent }};--ss-top:{{ section.settings.top_offset }}px;--ss-len:{{ section.settings.length }}00vh}
.ss{--ss-display:"Archivo","Helvetica Neue",Arial,sans-serif;--ss-serif:"Bodoni Moda","Didot",Georgia,serif;--ss-sans:"Inter","Helvetica Neue",Arial,sans-serif;--ss-mono:"IBM Plex Mono","SFMono-Regular",Menlo,monospace;--ss-muted:color-mix(in srgb,var(--ss-fg) 64%,var(--ss-bg));--ss-line:color-mix(in srgb,var(--ss-fg) 14%,var(--ss-bg));--ss-ease:cubic-bezier(.2,.7,.2,1);--ss-gutter:clamp(20px,5vw,72px);position:relative;height:var(--ss-len);background:var(--ss-bg);color:var(--ss-fg);font-family:var(--ss-sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
.ss *,.ss *:before,.ss *:after{box-sizing:border-box}
.ss-stage{position:sticky;top:var(--ss-top);height:calc(100vh - var(--ss-top));height:calc(100svh - var(--ss-top));overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,5vw,96px);align-items:center;max-width:1320px;margin-inline:auto;padding:clamp(24px,4vh,48px) var(--ss-gutter)}
.ss-copy{position:relative;height:min(520px,72vh)}
.ss-panel{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;opacity:0;pointer-events:none}
.ss-panel.is-on{pointer-events:auto}
.ss-eyebrow{display:inline-flex;align-items:center;gap:12px;margin:0 0 24px;font-family:var(--ss-mono);font-size:11.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ss-muted)}
.ss-eyebrow:before{content:"";width:7px;height:7px;background:var(--ss-accent);flex:none}
.ss-h{margin:0;font-family:var(--ss-display);font-stretch:125%;font-weight:600;font-size:clamp(40px,5.6vw,96px);line-height:.98;letter-spacing:-.015em;text-transform:uppercase;color:inherit}
.ss-h span{display:block;overflow:hidden;padding-bottom:.06em}
.ss-h span>*{display:block;transform:translateY(var(--rise,0%))}
.ss-h em{font-family:var(--ss-serif);font-stretch:100%;font-style:italic;font-weight:400;letter-spacing:-.02em;text-transform:none}
.ss-body{max-width:44ch;margin:28px 0 0;font-size:clamp(15px,1.05vw,16.5px);line-height:1.75;color:var(--ss-muted)}
.ss-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px 28px;margin-top:36px}
.ss .ss-btn{position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:0 34px;border:1.5px solid var(--ss-fg);border-radius:0;background:var(--ss-fg);color:var(--ss-bg);font-family:var(--ss-mono);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;transition:color .5s var(--ss-ease),border-color .5s var(--ss-ease)}
.ss .ss-btn:before{content:"";position:absolute;inset:0;z-index:-1;background:var(--ss-accent);transform:scaleX(0);transform-origin:right;transition:transform .6s var(--ss-ease)}
.ss .ss-btn:hover{color:#111;border-color:var(--ss-accent)}
.ss .ss-btn:hover:before{transform:scaleX(1);transform-origin:left}
.ss .ss-link{display:inline-flex;align-items:center;padding-bottom:6px;background:linear-gradient(currentColor,currentColor) left bottom/100% 1px no-repeat;font-family:var(--ss-mono);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:var(--ss-fg);transition:background-size .6s var(--ss-ease)}
.ss .ss-link:hover{background-size:35% 1px}
.ss .ss-btn:focus-visible,.ss .ss-link:focus-visible,.ss-rail button:focus-visible{outline:1px solid var(--ss-accent);outline-offset:4px}
.ss-visual{position:relative;justify-self:center;height:min(76vh,calc((50vw - 60px) * 1.25));aspect-ratio:4/5}
.ss-art{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ss-frame{position:absolute;inset:0;overflow:hidden;clip-path:inset(100% 0 0 0);background:color-mix(in srgb,var(--ss-fg) 5%,var(--ss-bg))}
.ss-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(var(--zoom,1.12));will-change:transform}
.ss-count{position:absolute;left:0;bottom:-34px;font-family:var(--ss-mono);font-size:11px;font-weight:500;letter-spacing:.16em;color:var(--ss-muted)}
.ss-count b{font-weight:500;color:var(--ss-fg)}
.ss .patch{opacity:0}
.ss-hfill [stroke="#000"]{stroke:color-mix(in srgb,var(--ss-fg) 26%,#000)}
.ss-chip{position:absolute;display:flex;flex-direction:column;gap:4px;padding:12px 16px 13px;background:color-mix(in srgb,var(--ss-bg) 90%,transparent);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:var(--ss-fg);border:1px solid var(--ss-line);opacity:0;white-space:nowrap}
.ss-chip small{font-family:var(--ss-mono);font-size:10.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ss-muted);display:flex;align-items:center;gap:8px}
.ss-chip small:before{content:"";width:5px;height:5px;background:var(--ss-accent)}
.ss-chip strong{font-family:var(--ss-display);font-stretch:112%;font-size:13px;font-weight:600;letter-spacing:.02em;text-transform:uppercase}
.ss-top-left{left:-9%;top:12%}.ss-top-right{right:-7%;top:8%}.ss-bottom-left{left:-7%;top:62%}.ss-bottom-right{right:-7%;top:84%}
.ss-rail{position:absolute;right:max(4px,calc(var(--ss-gutter) * .5 - 22px));top:50%;transform:translateY(-50%);display:flex;flex-direction:column}
.ss-rail button{width:44px;height:40px;border:0;background:none;cursor:pointer;display:grid;place-items:center;padding:0;color:inherit}
.ss-rail button:after{content:"";width:7px;height:7px;border:1px solid var(--ss-muted);transition:background .4s var(--ss-ease),border-color .4s var(--ss-ease)}
.ss-rail button[aria-current="true"]:after{background:var(--ss-accent);border-color:var(--ss-accent)}
.ss-scroll{position:absolute;left:50%;bottom:24px;width:1px;height:54px;overflow:hidden;background:color-mix(in srgb,var(--ss-fg) 30%,transparent)}
.ss-scroll:after{content:"";position:absolute;inset:0;background:var(--ss-fg);animation:ss-scroll 2.4s var(--ss-ease) infinite}
@keyframes ss-scroll{0%{transform:translateY(-100%)}60%,to{transform:translateY(100%)}}
@media (max-width:899px){
  .ss-stage{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);gap:18px;align-items:start;padding-top:20px;padding-bottom:28px}
  .ss-copy{height:clamp(230px,36vh,300px)}
  .ss-panel{justify-content:flex-start}
  .ss-eyebrow{margin-bottom:14px}
  .ss-h{font-size:clamp(34px,10.5vw,60px)}
  .ss-body{font-size:14px;line-height:1.6;margin-top:14px}
  .ss-actions{margin-top:18px}
  .ss .ss-btn{min-height:48px;padding:0 24px}
  .ss-visual{height:auto;width:min(100%,calc((100svh - var(--ss-top)) * .44));justify-self:center;align-self:center}
  .ss-chip{padding:6px 9px 7px;gap:2px}.ss-chip strong{font-size:10.5px}.ss-chip small{font-size:9px}
  .ss-top-left,.ss-bottom-left{left:-2%}.ss-top-right,.ss-bottom-right{right:-2%}
  .ss-count,.ss-rail,.ss-scroll{display:none}
}
@media (prefers-reduced-motion:reduce){.ss-scroll{display:none}}

</style>
