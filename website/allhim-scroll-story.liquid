        {%- if forloop.first -%}<h1 class="ss-h">{%- else -%}<h2 class="ss-h">{%- endif -%}
          <span><span>{{ block.settings.line1 | escape }}</span></span>{%- if block.settings.line2 and block.settings.line2 != blank -%}<span><em>{{ block.settings.line2 | escape }}</em></span>{%- endif -%}
        {%- if forloop.first -%}</h1>{%- else -%}</h2>{%- endif -%}
        {%- if block.settings.text and block.settings.text != blank -%}<p class="ss-body">{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
        {%- if block.settings.button_label and block.settings.button_label != blank or block.settings.link_label and block.settings.link_label != blank -%}
        <div class="ss-actions">
